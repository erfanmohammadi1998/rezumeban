# ── رزومه‌بان — backend environment ──────────────────────────────────────────
# Copy to .env and fill in for production. Dev works with all defaults.

# Core
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=rezumeban.example.com,www.rezumeban.example.com
CSRF_TRUSTED_ORIGINS=https://rezumeban.example.com
TIME_ZONE=Asia/Tehran

# Database (leave empty for SQLite)
DATABASE_URL=postgres://rezumeban:rezumeban@db:5432/rezumeban

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=https://rezumeban.example.com

# Media / uploads
MEDIA_ROOT=/data/media
MAX_UPLOAD_MB=8

# JWT lifetimes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Rate limits
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour
THROTTLE_AUTH=10/min
THROTTLE_APPLY=10/hour

# Email (candidate + team notifications). Console backend if unset in DEBUG.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@rezumeban.example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=رزومه‌بان <no-reply@rezumeban.example.com>
CANDIDATE_EMAILS_ENABLED=1

# HTTPS hardening (only applied when DJANGO_DEBUG=0)
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=2592000

# Feature modules: core,recruitment,sourcing  (core alone = résumé bank only)
TALENTBASE_MODULES=core,recruitment,sourcing

# Optional
# SENTRY_DSN=
# GITHUB_TOKEN=
# STACKEXCHANGE_KEY=
LOG_LEVEL=INFO
